{
  "name": "Orbit Bots (Ollama, lokalne modele)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "hostRequirements": { "cpus": 4, "memory": "16gb", "storage": "32gb" },
  "containerEnv": {
    "LLM_BASE_URL": "http://localhost:11434/v1",
    "LLM_MODEL": "dolphin3:8b",
    "LLM_API_KEY": "ollama",
    "OPENAI_BASE_URL": "http://localhost:11434/v1",
    "OPENAI_MODEL": "dolphin3:8b",
    "ORBIT_USE_OLLAMA": "1",
    "ORBIT_USE_LOCAL_VIDEO": "0",
    "ORBIT_SMALL_MODEL": "qwen3:4b",
    "PORT": "8000"
  },
  "forwardPorts": [8000, 11434],
  "portsAttributes": {
    "8000": { "label": "Orbit", "onAutoForward": "openBrowser" },
    "11434": { "label": "Ollama API", "onAutoForward": "silent" }
  },
  "postCreateCommand": "bash .devcontainer/post-create.sh",
  "postStartCommand": "bash .devcontainer/post-start.sh"
}
