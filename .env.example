# Orbit Bots — Konfiguracja Zmiennych Środowiskowych (.env)
# Skopiuj ten plik do .env na maszynie deweloperskiej lub wprowadź zmienne w panelu Render -> Environment.
# NIGDY NIE COMMITUJ PLIKU .env Z PRAWDZIWYMI SECRETAMI!

# 1. Klucz darmowego Gemini API (Google AI Studio: https://aistudio.google.com/)
# Używany przez pętlę function-calling core/agent.py z modelem gemini-3.5-flash-lite
LLM_API_KEY=

# 2. Google OAuth 2.0 Web Client dla Gmail (Tylko odczyt: scope https://www.googleapis.com/auth/gmail.readonly)
# Szczegółowa instrukcja konfiguracji: patrz docs/GMAIL_SETUP.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://orbit-bots.onrender.com/auth/google/callback

# 3. Bezpieczeństwo panelu (HTTP Basic Auth)
# Chroni wszystkie strony i endpointy API (poza /health i /auth/google/callback)
# Wymóg bezpieczeństwa: jeśli podłączono pocztę lub konta, a hasło nie jest ustawione -> dostęp jest blokowany (403).
ORBIT_PANEL_PASSWORD=

# 4. Klucz sejfu Fernet (opcjonalny na Renderze; generowany automatycznie w ~/.orbit/vault.key jeśli brak)
ORBIT_VAULT_KEY_B64=

# 5. Opcje uruchomieniowe serwera
PORT=5003
ORBIT_FLIGHTS_EVERY_H=6
